{
  "name": "git-log-selection",
  "displayName": "Git Log Selection",
  "description": "Find the Git commits that introduced the first line of the editor selection.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:gitLogSelection.findIntroduction"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitLogSelection.findIntroduction",
        "title": "Git Log: Find Selected Line Introduction"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "gitLogSelection.findIntroduction",
          "when": "editorHasSelection",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}